# Makefile for ARM using clang
CXX ?= clang++

# Compiler flags (optimized for performance)
CFLAGS = -std=c++17 -Ofast -funroll-loops -ftree-vectorize -fstrict-aliasing \
         -fno-semantic-interposition -fno-trapping-math \
         -flto -fassociative-math -fopenmp -mcpu=native

# Linker flags
LDFLAGS = -fopenmp

# Source files
SOURCES = Cyclone.cpp SECP256K1.cpp Int.cpp IntGroup.cpp IntMod.cpp Point.cpp \
          ripemd160_neon.cpp p2pkh_decoder.cpp sha256_neon.cpp Timer.cpp Random.cpp

# Object files
OBJECTS = $(SOURCES:.cpp=.o)

# Final executable
TARGET = Cyclone

# Default target: build the executable
all: $(TARGET)

# Rule to compile .cpp files into .o files
%.o: %.cpp
	$(CXX) $(CFLAGS) -c $< -o $@

# Rule to link object files and generate the final executable
$(TARGET): $(OBJECTS)
	$(CXX) $(CFLAGS) $(OBJECTS) -o $@ $(LDFLAGS)

# Clean up generated files
clean:
	rm -f $(TARGET) $(OBJECTS)
